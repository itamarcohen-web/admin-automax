# ---------------------------------------------------------------------------------------------------------------------
# AutoMax Admin - environment variables. Copy to .env.local (never commit it).
#
# FRONT END (public by design - these two values are visible in the browser bundle):
#   NEXT_PUBLIC_SUPABASE_URL       your project URL, https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  the PUBLISHABLE key (sb_publishable_...) or the legacy anon key. NEVER a secret/service_role key.
# ---------------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: minutes of inactivity before the console signs itself out (default 30).
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# ---------------------------------------------------------------------------------------------------------------------
# SERVER SIDE ONLY - these are NOT read by the Next.js app. They are Supabase Edge Function secrets, set with
#   supabase secrets set NAME=value        (or Dashboard -> Edge Functions -> Secrets)
# and they must never be placed in a NEXT_PUBLIC_* variable, in this file's committed copy, in Git or in the browser.
#
# SUPABASE_URL                  injected by Supabase automatically
# SUPABASE_SERVICE_ROLE_KEY     injected by Supabase automatically (or set ADMIN_SERVICE_KEY to an sb_secret_... key instead)
# ADMIN_ALLOWED_ORIGINS=https://admin.auto-max.co.il          comma separated; add http://localhost:3000 only for local development
# ADMIN_REQUIRE_MFA=false                                     true = every admin must enrol TOTP (recommended once your own is set up)
# PASSWORD_RESET_REDIRECT=https://auto-max.co.il/account      where the "reset password" e-mail link lands (must be in Auth -> URL Configuration)
# RELEASE_MAX_BYTES=52428800                                  upload limit of your Supabase plan (50 MB on the free plan)
# ---------------------------------------------------------------------------------------------------------------------
